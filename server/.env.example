# ----- Strava OAuth (Phase 1) -----
# Cree ton app sur https://www.strava.com/settings/api puis copie les valeurs ici.
# IMPORTANT: dans les reglages de l'app Strava, mets "Authorization Callback Domain" = localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# URL de callback OAuth (doit pointer vers CE backend). Laisse la valeur par defaut en local.
STRAVA_REDIRECT_URI=http://localhost:3001/api/auth/strava/callback

# ----- Serveur -----
PORT=3001
# Origine du frontend (Vite). Sert au CORS et a la redirection apres connexion.
FRONTEND_URL=http://localhost:5173

# Chemin du fichier SQLite (relatif au dossier server/)
DB_PATH=./data/app.db

# ----- Anthropic (Phase 4 - pas utilise encore) -----
# ANTHROPIC_API_KEY=
