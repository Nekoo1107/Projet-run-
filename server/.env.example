# ----- Strava OAuth (Phase 1) -----
# Cree ton app sur https://www.strava.com/settings/api puis copie les valeurs ici.
# IMPORTANT: dans les reglages de l'app Strava, mets "Authorization Callback Domain" = localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# URL de callback OAuth (doit pointer vers CE backend). Laisse la valeur par defaut en local.
STRAVA_REDIRECT_URI=http://localhost:3001/api/auth/strava/callback

# ----- Serveur -----
PORT=3001
# Origine du frontend (Vite). Sert au CORS et a la redirection apres connexion.
FRONTEND_URL=http://localhost:5173

# Chemin du fichier SQLite (relatif au dossier server/)
DB_PATH=./data/app.db

# ----- Coach IA (Phase 4) -----
# Le coach utilise Gemini si GEMINI_API_KEY est presente, sinon Anthropic.
# Gemini : cle GRATUITE depuis https://aistudio.google.com/ -> "Get API key"
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Alternative : Anthropic (facture au token) depuis https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# ----- COROS (Phase 6, OPTIONNEL) -----
# L'API COROS necessite un acces developpeur/partenaire (pas garanti). L'app
# fonctionne sans : saisie manuelle de HRV/sommeil/recup dans l'onglet Sante.
# Module branchable : renseigner ces cles quand l'acces est obtenu.
# COROS_CLIENT_ID=
# COROS_CLIENT_SECRET=
